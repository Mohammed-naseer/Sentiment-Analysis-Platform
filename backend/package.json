{
  "name": "ai-sentiment-backend",
  "version": "2.0.0",
  "description": "Production-ready multi-model AI Sentiment Analysis backend using Node.js, Express, TypeScript, MongoDB Atlas, Firebase Admin SDK, Google Gemini, Groq, and Hugging Face.",
  "main": "dist/server.js",
  "scripts": {
    "build": "rimraf dist && tsc",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "lint": "eslint . --ext .ts",
    "clean": "rimraf dist node_modules"
  },
  "dependencies": {
    "@google/genai": "^2.16.0",
    "@google/generative-ai": "^0.21.0",
    "@huggingface/inference": "^4.13.25",
    "@types/multer": "^2.2.0",
    "@types/pdf-parse": "^1.1.5",
    "cors": "^2.8.5",
    "csv-parser": "^3.2.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "express-validator": "^7.1.0",
    "firebase-admin": "^12.1.0",
    "groq-sdk": "^0.9.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.4.0",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "pdf-parse": "^2.4.5",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.12.7",
    "@types/nodemailer": "^8.0.1",
    "mongodb-memory-server": "^11.2.0",
    "rimraf": "^5.0.5",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
